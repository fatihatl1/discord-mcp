# Required. Bot token from https://discord.com/developers/applications -> your app -> Bot.
# Never commit the real value.
DISCORD_BOT_TOKEN=your-bot-token-here

# Optional. Discord REST API version. Default: v10
DISCORD_API_VERSION=v10

# Optional. When "true", no write request ever reaches Discord. Write tools
# return the request they would have made instead. Default: false
DRY_RUN=false

# Optional. One of: debug, info, warn, error, silent. Default: info
# All logs go to stderr (stdout carries the MCP protocol in stdio mode).
LOG_LEVEL=info

# Optional. Minimum delay in milliseconds between consecutive write requests
# to Discord. Default: 250
WRITE_DELAY_MS=250

# Required in HTTP mode only (--http). Clients must send
# "Authorization: Bearer <this value>". Generate something long and random:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# Optional. The single guild webhook management and the News Worker are
# restricted to. Default: the BULLHAUS guild (1307135789364154459).
DISCORD_GUILD_ID=1307135789364154459

# --- BULLHAUS News Worker (src/news/cli.ts -- `npm run news` / `npm run news:dry`) ---

# Optional. Default: true. While true, the worker NEVER sends, edits, or
# deletes a Discord message. `npm run news:dry` forces this on regardless.
NEWS_DRY_RUN=true

# Optional. Default: false. Master live-publication switch. Still gated per
# provider below -- turning this on does not by itself approve anything.
NEWS_PUBLISH_ENABLED=false

# Optional. Default: false. Finnhub-specific redistribution approval. Being
# on the Finnhub free tier does NOT imply this is set; confirm your Finnhub
# plan's license actually permits the intended BULLHAUS publication model
# before setting this to true. Approving Finnhub does not approve any RSS
# source, and vice versa -- see src/news/rss/sources.ts for per-feed approval.
NEWS_LICENSE_APPROVED=false

# Optional. Comma-separated: mock, finnhub, official_rss. Default: mock.
# Finnhub is the intended BULLHAUS production provider. Mock is for
# development/testing only and is hard-blocked from live publication in code
# regardless of this setting. Official RSS remains implemented but disabled
# (see src/news/rss/sources.ts) -- do not enable it here.
NEWS_PROVIDERS=mock

# Optional. Default: 60. Items older than this (by publication time) are
# never published.
NEWS_MAX_AGE_MINUTES=60

# Optional. Default: 3. Caps how many items are published per channel per run.
NEWS_MAX_POSTS_PER_CHANNEL=3

# Optional. Default: 100. How many recent messages per channel the duplicate
# check scans. A bounded window, not a permanent history.
NEWS_HISTORY_LOOKBACK=100

# Required only when NEWS_PROVIDERS includes "finnhub". Never hard-code this
# anywhere in source. Get one at https://finnhub.io/.
FINNHUB_API_KEY=
